# --- Form delivery (Web3Forms: https://web3forms.com) -------------------------
# Create one access key per destination mailbox (a key is bound to the email
# you enter when creating it). These keys are PUBLIC by design - they are sent
# from the browser - so it is fine for them to be embedded in the built site.
#
# -> info@asbinnovations.com  (RCM, SOC, QuickBooks, Cybersecurity, Offshore PM, Contact)
PUBLIC_FORM_KEY_INFO=
# -> noc@asbinnovations.com   (NOC page)
PUBLIC_FORM_KEY_NOC=
# -> hardwarerental@asbinnovations.com (IT Hardware Rental page)
PUBLIC_FORM_KEY_HARDWARE=

# Optional: use another provider endpoint (default is Web3Forms)
# PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit

# Local testing ONLY: "1" simulates a successful submission without any network
# call, so you can test the brochure unlock flow. NEVER set this in production.
# PUBLIC_FORM_MOCK=1

# --- Site ---------------------------------------------------------------------
# Canonical origin used for sitemap, canonical links and Open Graph URLs.
# SITE_URL=https://www.your-domain.com
