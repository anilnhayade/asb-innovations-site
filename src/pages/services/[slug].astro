---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import ComparisonCards from '../../components/ComparisonCards.astro';
import CTABanner from '../../components/CTABanner.astro';
import LeadForm from '../../components/LeadForm.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const pages = await getCollection('services');
  return pages.map((p) => ({ params: { slug: p.data.slug }, props: { page: p.data } }));
}

const { page } = Astro.props;
const { banner, sections, cta } = page;

// Alternate section backgrounds like the reference design
const bg = (i: number) => (i % 2 === 0 ? '' : 'section--alt');

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Services' }, { label: banner.title }];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: banner.title, item: new URL(Astro.url.pathname, Astro.site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: banner.title,
    provider: { '@type': 'Organization', name: site.name },
    description: page.seo.description,
    areaServed: page.slug === 'it-hardware-rental' ? site.serviceArea : 'Worldwide',
  },
];
---

<BaseLayout title={page.seo.title} description={page.seo.description} jsonLd={jsonLd}>
  <PageBanner {...banner} {crumbs} />

  {sections.map((s, i) => (
    <section class:list={['section', bg(i)]} aria-labelledby={s.heading ? `s${i}` : undefined}>
      <div class:list={['container', { 'container--narrow': s.type === 'prose' }]}>
        {s.type === 'prose' && (
          <div class="prose prose--lead">
            {s.heading && <h2 id={`s${i}`} class="prose__h">{s.heading}</h2>}
            {s.paragraphs?.map((p) => <p>{p}</p>)}
          </div>
        )}

        {(s.type === 'numbered' || s.type === 'cards' || s.type === 'bullets') && (
          <>
            <SectionHeading eyebrow={s.eyebrow} title={s.heading!} intro={s.intro} />
            {s.lead && <p class="lead-in">{s.lead}</p>}
            <FeatureGrid
              items={s.items ?? []}
              variant={(s.variant as any) ?? (s.type === 'bullets' ? 'plain' : s.type === 'numbered' ? 'infographic' : 'cards')}
            />
            {s.closing && <p class="closing">{s.closing}</p>}
          </>
        )}

        {s.type === 'comparison' && (
          <>
            <SectionHeading eyebrow={s.eyebrow} title={s.heading!} intro={s.intro} align="center" />
            <ComparisonCards items={s.items ?? []} />
          </>
        )}

        {s.type === 'services' && (
          <>
            <SectionHeading eyebrow={s.eyebrow} title={s.heading!} intro={s.intro} />
            <ol class="svc">
              {(s.items ?? []).map((it, n) => (
                <li class="svc__item" data-tone={n % 2 === 0 ? 'teal' : 'gold'}>
                  <div class="svc__lead">
                    <span class="svc__num" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
                    {it.icon && <span class="icon-chip"><Icon name={it.icon} /></span>}
                    <h3><span class="sr-only">{n + 1}. </span>{it.title}</h3>
                    {it.subtitle && <p class="svc__sub">{it.subtitle}</p>}
                  </div>
                  <div class="svc__body">
                    {it.paragraphs?.map((p) => <p>{p}</p>)}
                  </div>
                  <div class="svc__features">
                    <h4>Key Features</h4>
                    <ul>
                      {it.features?.map((f) => <li><Icon name="check" size={16} strokeWidth={3} /><span>{f}</span></li>)}
                    </ul>
                  </div>
                </li>
              ))}
            </ol>
          </>
        )}

        {s.type === 'area' && (
          <div class="area">
            <div class="area__icon"><Icon name="map-pin" size={30} /></div>
            <div class="area__text">
              <h2 id={`s${i}`}>{s.heading}</h2>
              {s.paragraphs?.map((p) => <p>{p}</p>)}
              <ul class="area__places" aria-label="Service areas">
                {s.places?.map((pl) => <li>{pl}</li>)}
              </ul>
            </div>
          </div>
        )}

        {s.type === 'image' && s.src && (
          <figure class="figure">
            <img src={s.src} alt={s.alt ?? ''} width="720" height="540" loading="lazy" decoding="async" />
          </figure>
        )}
      </div>
    </section>
  ))}

  <CTABanner heading={cta.heading} text={cta.text} email={site.emails[cta.emailKey]} button={cta.button}>
    <LeadForm
      id="lead"
      formKey={cta.formKey}
      pageName={banner.title}
      title={cta.formTitle}
      fields={cta.fields}
      extra={cta.extra as 'requirements' | undefined}
      brochure={cta.brochure}
    />
  </CTABanner>
</BaseLayout>

<style>
  .prose__h { margin-bottom: var(--sp-5); }
  .lead-in { font: 600 var(--fs-lg)/1.4 var(--font-head); color: var(--ink); margin: calc(var(--sp-4) * -1) 0 var(--sp-5); }
  .closing { margin-top: var(--sp-6); padding: var(--sp-5) var(--sp-6); border-left: 4px solid var(--gold-500); background: var(--gold-50); border-radius: 0 var(--radius) var(--radius) 0; font-size: var(--fs-md); color: var(--ink); }

  /* Cybersecurity-style service blocks */
  .svc { display: grid; gap: var(--sp-5); }
  .svc__item { position: relative; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--sp-6); align-items: start;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--sp-6); box-shadow: var(--shadow-sm); overflow: hidden; }
  .svc__item::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 5px; background: var(--teal-600); }
  .svc__item[data-tone='gold']::before { background: var(--gold-500); }
  .svc__lead { display: flex; flex-direction: column; gap: var(--sp-3); align-items: flex-start; position: relative; }
  .svc__num { font: 800 2.75rem/1 var(--font-head); color: transparent; -webkit-text-stroke: 1.5px var(--teal-600); letter-spacing: -0.03em; }
  .svc__item[data-tone='gold'] .svc__num { -webkit-text-stroke-color: var(--gold-500); }
  .svc__sub { margin: 0; color: var(--gold-600); font-weight: 600; font-size: var(--fs-sm); }
  .svc__body p { font-size: var(--fs-base); }
  .svc__features { background: var(--bg-alt); border-radius: var(--radius); padding: var(--sp-5); }
  .svc__features h4 { font: 700 var(--fs-xs) var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal-700); margin-bottom: var(--sp-3); }
  .svc__features ul { display: grid; gap: var(--sp-3); }
  .svc__features li { display: flex; gap: var(--sp-3); align-items: flex-start; color: var(--ink); font-size: var(--fs-sm); font-weight: 500; }
  .svc__features li :global(svg) { flex: none; margin-top: 3px; padding: 2px; border-radius: 50%; background: var(--teal-600); color: #fff; box-sizing: content-box; width: 12px; height: 12px; }
  @media (max-width: 1060px) {
    .svc__item { grid-template-columns: 1fr 1fr; }
    .svc__lead { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: center; }
    .svc__sub { flex-basis: 100%; }
  }
  @media (max-width: 680px) { .svc__item { grid-template-columns: 1fr; padding: var(--sp-5); } }

  /* Hardware service area */
  .area { display: flex; gap: var(--sp-5); align-items: flex-start; padding: var(--sp-6); background: linear-gradient(135deg, var(--teal-50), #fff); border: 1px solid var(--teal-100); border-radius: var(--radius-lg); }
  .area__icon { display: grid; place-items: center; flex: none; width: 64px; height: 64px; border-radius: 18px; background: var(--teal-700); color: #fff; }
  .area h2 { font-size: var(--fs-h3); margin-bottom: var(--sp-3); }
  .area__places { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-4); }
  .area__places li { padding: 0.45rem 0.9rem; border-radius: 99px; background: #fff; border: 1px solid var(--gold-500); color: var(--teal-900); font-weight: 600; font-size: var(--fs-sm); }
  @media (max-width: 560px) { .area { flex-direction: column; padding: var(--sp-5); } }

  .figure { max-width: 760px; margin: 0 auto; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); background: var(--bg-alt); box-shadow: var(--shadow); }
  .figure img { width: 100%; height: auto; }
</style>
