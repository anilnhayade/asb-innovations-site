---
import BannerArt from './BannerArt.astro';
import Icon from './Icon.astro';
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  art: string;
  icon: string;
  crumbs?: { label: string; href?: string }[];
}
const { eyebrow, title, subtitle, art, icon, crumbs = [] } = Astro.props;
---

<section class="pb">
  <div class="container pb__inner">
    <div class="pb__text">
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="pb__crumbs">
          <ol>
            {crumbs.map((c, i) => (
              <li>
                {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
                {i < crumbs.length - 1 && <Icon name="chevron-right" size={14} />}
              </li>
            ))}
          </ol>
        </nav>
      )}
      {eyebrow && <p class="pb__pill"><span class="dot"></span>{eyebrow}</p>}
      <h1>{title}</h1>
      {subtitle && <p class="pb__sub">{subtitle}</p>}
    </div>
    <div class="pb__art"><BannerArt art={art} icon={icon} /></div>
  </div>
</section>

<style>
  .pb { position: relative; overflow: hidden; color: #fff;
    background: radial-gradient(900px 420px at 85% 10%, rgb(200 150 30 / 0.25), transparent 60%), linear-gradient(120deg, var(--teal-950), var(--teal-800) 55%, var(--teal-600)); }
  .pb::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgb(255 255 255 / 0.1) 1px, transparent 1px); background-size: 26px 26px; mask-image: linear-gradient(90deg, transparent, #000 70%); pointer-events: none; }
  .pb__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: var(--sp-7); align-items: center; padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  .pb h1 { color: #fff; max-width: 18ch; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); }
  .pb__sub { margin-top: var(--sp-4); font-size: var(--fs-lg); color: rgb(255 255 255 / 0.88); max-width: 46ch; }
  .pb__pill { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0 var(--sp-4); padding: 0.35rem 0.8rem; border-radius: 6px;
    background: rgb(255 255 255 / 0.12); border: 1px solid rgb(255 255 255 / 0.25); font: 700 var(--fs-xs) var(--font-body); letter-spacing: 0.1em; text-transform: uppercase; color: #fff; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold-400); }
  .pb__crumbs { margin-bottom: var(--sp-5); font-size: var(--fs-sm); }
  .pb__crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); }
  .pb__crumbs li { display: inline-flex; align-items: center; gap: var(--sp-2); color: rgb(255 255 255 / 0.75); }
  .pb__crumbs a { color: rgb(255 255 255 / 0.9); text-decoration: none; }
  .pb__crumbs a:hover { color: #fff; text-decoration: underline; }
  .pb__crumbs [aria-current] { color: var(--gold-400); }
  @media (max-width: 900px) {
    .pb__inner { grid-template-columns: 1fr; }
    .pb__art { order: -1; max-width: 220px; margin-inline: 0; }
    .pb h1 { max-width: none; }
  }
  @media (max-width: 560px) { .pb__art { max-width: 150px; } }
</style>
