---
import Icon from './Icon.astro';
/**
 * Decorative banner illustration (no photo licensing needed).
 * `medical-billing` is a hand-drawn scene; all others use a central icon with orbiting chips.
 */
interface Props { art: string; icon: string }
const { art, icon } = Astro.props;

const satellites: Record<string, string[]> = {
  network: ['radar', 'server', 'gauge'],
  security: ['lock', 'eye', 'siren'],
  accounting: ['receipt', 'chart-column', 'wallet'],
  project: ['calendar-check', 'users', 'target'],
  hardware: ['monitor', 'cpu', 'headset'],
  contact: ['mail', 'message-circle', 'map-pin'],
  home: ['cloud', 'shield-check', 'server'],
};
const sats = satellites[art] ?? ['layers', 'shield-check', 'zap'];
---

{art === 'medical-billing' ? (
  <svg class="art art--bill" viewBox="0 0 440 340" role="img" aria-label="Illustration of a medical claim form, a stethoscope and coins">
    <defs>
      <linearGradient id="g-card" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#e3f1f3" /></linearGradient>
      <linearGradient id="g-gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e8c25f" /><stop offset="1" stop-color="#c8961e" /></linearGradient>
    </defs>
    <circle cx="220" cy="170" r="150" fill="rgb(255 255 255 / 0.07)" />
    <circle cx="220" cy="170" r="110" fill="rgb(255 255 255 / 0.07)" />
    <!-- claim form -->
    <g transform="rotate(-6 200 170)">
      <rect x="110" y="40" width="210" height="270" rx="16" fill="url(#g-card)" />
      <rect x="110" y="40" width="210" height="48" rx="16" fill="#0e7c86" />
      <rect x="110" y="70" width="210" height="18" fill="#0e7c86" />
      <rect x="130" y="56" width="70" height="10" rx="5" fill="#ffffff" opacity="0.9" />
      <g transform="translate(272 48)"><rect x="-4" y="-2" width="26" height="26" rx="6" fill="#fff" /><path d="M9 3h4v6h6v4h-6v6H9v-6H3V9h6z" fill="#c8961e" /></g>
      <rect x="130" y="108" width="100" height="9" rx="4.5" fill="#0a3440" opacity="0.75" />
      <rect x="130" y="128" width="160" height="7" rx="3.5" fill="#0a3440" opacity="0.2" />
      <rect x="130" y="144" width="140" height="7" rx="3.5" fill="#0a3440" opacity="0.2" />
      <rect x="130" y="170" width="160" height="1.5" fill="#0a3440" opacity="0.15" />
      <g fill="#0a3440" opacity="0.8"><rect x="130" y="186" width="54" height="8" rx="4" /><rect x="130" y="208" width="54" height="8" rx="4" /><rect x="130" y="230" width="54" height="8" rx="4" /></g>
      <g fill="#0a3440" opacity="0.25"><rect x="200" y="186" width="90" height="8" rx="4" /><rect x="200" y="208" width="90" height="8" rx="4" /><rect x="200" y="230" width="90" height="8" rx="4" /></g>
      <g fill="none" stroke="#0e7c86" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M288 190l5 5 9-10" /><path d="M288 212l5 5 9-10" /><path d="M288 234l5 5 9-10" /></g>
      <rect x="130" y="262" width="160" height="30" rx="8" fill="#fcf7ea" stroke="#c8961e" stroke-width="1.5" />
      <text x="142" y="282" font-family="Plus Jakarta Sans Variable, sans-serif" font-weight="700" font-size="13" fill="#0a3440">CLAIM APPROVED</text>
    </g>
    <!-- stethoscope -->
    <g fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" transform="translate(300 150)">
      <path d="M0 0v34a40 40 0 0 0 80 0V0" opacity="0.95" />
      <path d="M-8 -8h16M72 -8h16" />
      <path d="M40 74v26a32 32 0 0 0 64 0v-8" />
    </g>
    <circle cx="404" cy="236" r="16" fill="url(#g-gold)" stroke="#fff" stroke-width="4" />
    <!-- coins -->
    <g>
      <ellipse cx="86" cy="276" rx="44" ry="14" fill="#a97b10" /><rect x="42" y="258" width="88" height="18" fill="#a97b10" /><ellipse cx="86" cy="258" rx="44" ry="14" fill="url(#g-gold)" />
      <ellipse cx="86" cy="244" rx="44" ry="14" fill="#a97b10" /><rect x="42" y="226" width="88" height="18" fill="#a97b10" /><ellipse cx="86" cy="226" rx="44" ry="14" fill="url(#g-gold)" />
      <text x="86" y="232" text-anchor="middle" font-family="Plus Jakarta Sans Variable, sans-serif" font-weight="800" font-size="18" fill="#0a3440">$</text>
    </g>
    <!-- sparkles -->
    <g fill="#e8c25f"><circle cx="60" cy="90" r="4" /><circle cx="390" cy="70" r="5" /><circle cx="360" cy="300" r="3" /></g>
  </svg>
) : (
  <div class="art art--orbit" aria-hidden="true">
    <span class="ring ring--1"></span>
    <span class="ring ring--2"></span>
    <span class="core"><Icon name={icon} /></span>
    {sats.map((s, i) => <span class={`sat sat--${i + 1}`}><Icon name={s} /></span>)}
  </div>
)}

<style>
  .art { width: 100%; max-width: 420px; margin-inline: auto; }
  .art--bill { height: auto; filter: drop-shadow(0 24px 30px rgb(0 0 0 / 0.25)); }
  .art--orbit { position: relative; aspect-ratio: 1; max-width: 340px; }
  .ring { position: absolute; border-radius: 50%; border: 1px dashed rgb(255 255 255 / 0.3); inset: 0; }
  .ring--1 { inset: 0; }
  .ring--2 { inset: 17%; border-style: solid; border-color: rgb(255 255 255 / 0.14); background: rgb(255 255 255 / 0.05); }
  .core { position: absolute; inset: 33%; border-radius: 28%; display: grid; place-items: center; color: var(--teal-950);
    background: linear-gradient(135deg, var(--gold-400), var(--gold-500)); box-shadow: 0 20px 40px -10px rgb(0 0 0 / 0.4); }
  .core :global(svg) { width: 46%; height: 46%; }
  .sat { position: absolute; width: 18%; aspect-ratio: 1; border-radius: 30%; display: grid; place-items: center; color: #fff;
    background: rgb(255 255 255 / 0.14); border: 1px solid rgb(255 255 255 / 0.35); backdrop-filter: blur(4px); }
  .sat :global(svg) { width: 50%; height: 50%; }
  .sat--1 { left: 41%; top: -4%; }
  .sat--2 { right: -3%; top: 58%; }
  .sat--3 { left: 4%; top: 64%; }
</style>
