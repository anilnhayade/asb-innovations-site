---
import Icon from './Icon.astro';
interface Props {
  icon: string;
  title: string;
  href?: string;
}
const { icon, title, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['sc', { 'sc--link': href }]} href={href}>
  <span class="sc__icon"><Icon name={icon} /></span>
  <span class="sc__title">{title}</span>
  {href && <span class="sc__more" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>}
</Tag>

<style>
  .sc {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    gap: var(--sp-4); text-align: center; text-decoration: none;
    padding: var(--sp-6) var(--sp-5) var(--sp-5); height: 100%;
    background: #fff; border: 1px solid var(--line-warm); border-radius: var(--radius);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .sc--link:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--teal-600); }
  .sc--link::before {
    content: ''; position: absolute; inset: -1px -1px auto; height: 3px; border-radius: var(--radius) var(--radius) 0 0;
    background: var(--gold-500); opacity: 0; transition: opacity 0.2s;
  }
  .sc--link:hover::before { opacity: 1; }
  .sc__icon {
    display: grid; place-items: center; width: 60px; height: 60px; border-radius: 16px;
    background: var(--teal-50); color: var(--teal-700); border: 1px solid var(--teal-100);
    transition: background-color 0.2s, color 0.2s;
  }
  .sc--link:hover .sc__icon { background: var(--teal-700); color: #fff; }
  .sc__icon :global(svg) { width: 28px; height: 28px; }
  .sc__title { font: 600 var(--fs-md)/1.3 var(--font-head); color: var(--ink); letter-spacing: -0.01em; }
  .sc__more { margin-top: auto; color: var(--gold-600); display: inline-flex; transition: transform 0.2s; }
  .sc--link:hover .sc__more { transform: translateX(4px); }
</style>
