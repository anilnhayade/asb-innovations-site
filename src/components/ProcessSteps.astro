---
import Icon from './Icon.astro';
/** Horizontal sequence (Track > Control > ...). Always one row on desktop; 3x2 on small phones. */
interface Props {
  steps: { icon: string; label: string }[];
  label?: string;
}
const { steps, label = 'Managed services process' } = Astro.props;
---

<ol class="ps" aria-label={label}>
  {steps.map((s, i) => (
    <li class="ps__step">
      <span class="ps__icon"><Icon name={s.icon} /></span>
      <span class="ps__label">{s.label}</span>
      {i < steps.length - 1 && <span class="ps__arrow" aria-hidden="true"><Icon name="chevron-right" size={20} /></span>}
    </li>
  ))}
</ol>

<style>
  .ps { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0; padding: var(--sp-5) var(--sp-4);
    background: linear-gradient(135deg, var(--teal-800), var(--teal-600)); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .ps__step { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--sp-2); padding: var(--sp-2) var(--sp-1); }
  .ps__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: rgb(255 255 255 / 0.12); color: var(--gold-400); border: 1px solid rgb(255 255 255 / 0.25); }
  .ps__icon :global(svg) { width: 24px; height: 24px; }
  .ps__label { color: #fff; font: 700 var(--fs-sm)/1.2 var(--font-head); letter-spacing: 0.04em; text-transform: uppercase; }
  .ps__arrow { position: absolute; right: -10px; top: 26px; transform: translateY(-50%); color: var(--gold-400); display: flex; z-index: 1; }
  @media (max-width: 560px) {
    .ps { grid-template-columns: repeat(3, 1fr); row-gap: var(--sp-4); }
    .ps__step:nth-child(3) .ps__arrow { display: none; }
    .ps__label { font-size: var(--fs-xs); }
    .ps__icon { width: 46px; height: 46px; }
  }
</style>
